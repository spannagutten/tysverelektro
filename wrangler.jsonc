{
  "name": "tysverelektro",
  "routes": [
    {
      "pattern": "te.erikerland.no",
      "custom_domain": true
    },
    {
      "pattern": "adm.te.erikerland.no",
      "custom_domain": true
    }
  ],
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/*",
      "!/images/*",
      "!/style.css",
      "!/cms.css",
      "!/guide-carousel.js",
      "!/admin/static/*"
    ]
  },
  "vars": {
    "SANITY_PROJECT_ID": "89cnbpsm",
    "SANITY_DATASET": "production"
  },
  "build": {
    "command": "node scripts/build.mjs"
  },
  "d1_databases": [
    {
      "binding": "SEARCH_STATS",
      "database_name": "tysverelektro-search-stats",
      "database_id": "e5196db7-e9c2-467b-9618-08e70deed7f4"
    }
  ],
  "triggers": {
    "crons": [
      "15 3 * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "SEARCH_EVENT_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
